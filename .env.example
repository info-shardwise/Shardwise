# ==============================================================================
# Shardwise Environment Configuration Template
# ==============================================================================

# Site URL (Canonical domain used for OpenGraph, Twitter Cards, Sitemap & JSON-LD)
NEXT_PUBLIC_SITE_URL=https://shardwise.pages.dev

# Resend API Configuration (Contact form submissions)
# Retrieve from: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=inquiries@shardwise.com
RESEND_TO_EMAIL=contact@shardwise.com

# Cloudflare Turnstile CAPTCHA (Form spam prevention)
# Retrieve from: Cloudflare Dashboard > Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
